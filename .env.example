# Copie para .env e ajuste os valores.

LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./copilot_job.db
PROFILE_PATH=profile_data/profile.json
# Habilita /preview/search com vagas simuladas (validação visual da interface)
UI_PREVIEW=false

# Provedor de LLM: gemini | ollama
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=120

# Gemini (obrigatório se LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama (servidor local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Ingestão de vagas (JobSpy): pausa aleatória entre requisições, em segundos
JOBSPY_MIN_DELAY_SECONDS=2
JOBSPY_MAX_DELAY_SECONDS=6
# Busca a descrição completa no LinkedIn (mais lento, mas essencial para o match)
JOBSPY_LINKEDIN_FETCH_DESCRIPTION=true
# Limite de requisições por hora (uma por plataforma consultada); 0 = sem limite
JOBSPY_MAX_REQUESTS_PER_HOUR=60

# CV Tailor: histórico completo, pasta dos PDFs, template Typst e padrão do PDF
# (ua-1 = acessibilidade validada; a-2a = arquivamento; none)
CV_LLM_TIMEOUT_SECONDS=600
CAREER_HISTORY_PATH=profile_data/profile_base.json
CV_OUTPUT_DIR=output_cvs
CV_TEMPLATE_PATH=templates/cv/ats_base.typ
CV_PDF_STANDARD=ua-1
